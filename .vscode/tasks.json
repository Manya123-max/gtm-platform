{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Backend API",
      "type": "shell",
      "command": ".\\venv\\Scripts\\Activate.ps1 ; uvicorn app.main:app --host 0.0.0.0 --port 8000 --reload",
      "options": { "cwd": "${workspaceFolder}/backend" }
    },
    {
      "label": "Celery Worker",
      "type": "shell",
      "command": ".\\venv\\Scripts\\Activate.ps1 ; celery -A app.core.celery_app worker --pool=solo --loglevel=info -Q default,agents,webhooks",
      "options": { "cwd": "${workspaceFolder}/backend" }
    },
    {
      "label": "Celery Beat",
      "type": "shell",
      "command": ".\\venv\\Scripts\\Activate.ps1 ; celery -A app.core.celery_app beat --loglevel=info",
      "options": { "cwd": "${workspaceFolder}/backend" }
    },
    {
      "label": "Frontend",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/frontend" }
    }
  ]
}