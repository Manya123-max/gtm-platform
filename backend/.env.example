# ═══════════════════════════════════════════════════════════════════════════
#  4CECloud Labs — GTM Platform  ·  backend/.env
#  Copy this file to .env and fill in your real keys.
#  Subscription tiers assumed: Claude AI paid · Apollo.io Organization
# ═══════════════════════════════════════════════════════════════════════════

# ── App ──────────────────────────────────────────────────────────────────
APP_ENV=production
APP_SECRET_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_STRING
DEBUG=false
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
AGENT3_TEST_MODE=false

# ── Authentication (multi-user) ──────────────────────────────────────────
# Set false only for legacy local dev without login (NOT recommended)
AUTH_ENABLED=true
# Separate JWT secret; falls back to APP_SECRET_KEY when empty
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14
# Email of the account that pre-migration (anonymous) GTM data is assigned to.
# Leave EMPTY to never silently assign ownership (legacy rows stay invisible
# to authenticated users until you set this and restart).
GTM_MIGRATION_OWNER_EMAIL=

# ── Database / Redis ─────────────────────────────────────────────────────
POSTGRES_USER=gtm
POSTGRES_PASSWORD=gtmpass
POSTGRES_DB=gtm
DATABASE_URL=postgresql+asyncpg://gtm:gtmpass@localhost:5432/gtm
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── Anthropic / Claude AI (paid subscription) ────────────────────────────
# Get from https://console.anthropic.com → API keys
# Models used: claude-sonnet-4-6 (complex) · claude-haiku-4-5-20251001 (fast)
ANTHROPIC_API_KEY=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
GROQ_API_KEY=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
GEMINI_API_KEY=AQ.Ab8RN6JcOZWYmc_LzleObqnIaL_KUDh2V0sagxmsBtuiemnjiQ
MISTRAL_API_KEY=NlSTFA9PT7UzOhfqbPVxmjZn7r5zvy39
DEEPSEEK_API_KEY=sk-e6f3e12585a84feeb416e544581f5230
JINA_API_KEY=jina_0c56af40daca486c81b751f8be934499FLRl0e_TE9-n7YJ4bsM_pg9bnirs
USE_GROQ=true
