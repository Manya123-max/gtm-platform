# ═══════════════════════════════════════════════════════════════════════════
#  4CECloud Labs — GTM Platform  ·  backend/.env
#  Copy this file to .env and fill in your real keys.
#  Subscription tiers assumed: Claude AI paid · Apollo.io Organization
# ═══════════════════════════════════════════════════════════════════════════

# ── App ──────────────────────────────────────────────────────────────────
APP_ENV=production
APP_SECRET_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_STRING
DEBUG=false
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ── Authentication (multi-user) ──────────────────────────────────────────
# Set false only for legacy local dev without login (NOT recommended)
AUTH_ENABLED=true
# Separate JWT secret; falls back to APP_SECRET_KEY when empty
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14
# Email of the account that pre-migration (anonymous) GTM data is assigned to.
# Leave EMPTY to never silently assign ownership (legacy rows stay invisible
# to authenticated users until you set this and restart).
GTM_MIGRATION_OWNER_EMAIL=

# ── Database / Redis ─────────────────────────────────────────────────────
POSTGRES_USER=gtm
POSTGRES_PASSWORD=gtmpass
POSTGRES_DB=gtm
DATABASE_URL=postgresql+asyncpg://gtm:gtmpass@db:5432/gtm
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ── Anthropic / Claude AI (paid subscription) ────────────────────────────
# Get from https://console.anthropic.com → API keys
# Models used: claude-sonnet-4-6 (complex) · claude-haiku-4-5-20251001 (fast)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
EMBEDDING_MODEL=hash

# ── Fallback LLM / API Providers ─────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
MISTRAL_API_KEY=your_mistral_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here
JINA_API_KEY=your_jina_api_key_here

# ── Apollo.io (Organization tier) ────────────────────────────────────────
# Organization tier: ~10 000 export credits/month + bulk enrichment + sequences
# Get from https://app.apollo.io/#/settings/integrations/api
APOLLO_API_KEY=your_apollo_api_key_here
APOLLO_SEARCH_MAX_PAGES=25

# ── Signal APIs ───────────────────────────────────────────────────────────
NEWS_API_KEY=your_news_api_key_here
ADZUNA_APP_ID=your_adzuna_app_id_here
ADZUNA_API_KEY=your_adzuna_api_key_here
APIFY_API_TOKEN=your_apify_api_token_here
CURRENTS_API_KEY=your_currents_api_key_here
PREDICTLEADS_API_KEY=your_predictleads_api_key_here
PREDICTLEADS_API_TOKEN=your_predictleads_api_token_here

# ── CRM / calendar ───────────────────────────────────────────────────────
HUBSPOT_ACCESS_TOKEN=your_hubspot_access_token_here
GMAIL_CLIENT_ID=your_gmail_client_id_here
GMAIL_CLIENT_SECRET=your_gmail_client_secret_here
GMAIL_REDIRECT_URI=http://localhost:8000/api/v1/auth/gmail/callback
CAL_COM_API_KEY=your_cal_com_api_key_here
CAL_COM_BASE_URL=https://api.cal.com/v2
CAL_COM_API_VERSION=2024-06-14
CAL_COM_EVENT_SLUG=your_cal_com_event_slug_here

# ── Outreach delivery ─────────────────────────────────────────────────────
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=gtm@yourdomain.com
FIREFLIES_API_KEY=your_fireflies_api_key_here
INSTANTLY_API_KEY=your_instantly_api_key_here
INSTANTLY_BASE_URL=https://api.instantly.ai
INSTANTLY_CAMPAIGN_ID=your_instantly_campaign_id_here

# ── Notifications (ntfy = default, no signup needed) ─────────────────────
NOTIFICATION_PROVIDER=ntfy
NTFY_BASE_URL=https://ntfy.sh
NTFY_APPROVAL_TOPIC=gtm-approvals-UNIQUEID
NTFY_ALERTS_TOPIC=gtm-alerts-UNIQUEID
SLACK_BOT_TOKEN=your_slack_bot_token_here
SLACK_SIGNING_SECRET=your_slack_signing_secret_here
SLACK_APPROVAL_CHANNEL=gtm-approvals
SLACK_ALERTS_CHANNEL=gtm-alerts

# ── Webhook secrets ───────────────────────────────────────────────────────
INBOUND_WEBHOOK_SECRET=your_inbound_webhook_secret_here
FIREFLIES_WEBHOOK_SECRET=your_fireflies_webhook_secret_here

# ── Feature flags ─────────────────────────────────────────────────────────
# STEP 1: Start with all false — run A1/A2 to populate data, verify output
# STEP 2: Flip ENABLE_EMAIL_SENDING + ENABLE_INSTANTLY once campaign is ready
# STEP 3: Set DRY_RUN_OUTREACH=false only after approving ≥5 test emails
ENABLE_EMAIL_SENDING=false
ENABLE_INSTANTLY=false
DRY_RUN_OUTREACH=true
REQUIRE_HUMAN_APPROVAL=true
ENABLE_SLACK_APPROVALS=false
ALLOW_DEMO_PROSPECTS=false

# ── Scoring thresholds ────────────────────────────────────────────────────
ICP_SCORE_THRESHOLD=70
SIGNAL_SCORE_THRESHOLD=40
READINESS_SCORE_MEETING_THRESHOLD=60
EMAIL_DEDUP_DAYS=60
SIGNAL_DEDUP_HOURS=24
CONTENT_DEDUP_HOURS=24
ALLOW_REPEAT_OUTREACH_FOR_NEW_SIGNAL=true

# ── Celery beat schedules (cron, no inline comments) ─────────────────────
PROSPECT_AGENT_SCHEDULE=0 8 * * 1
SIGNAL_AGENT_SCHEDULE=0 * * * *
CONTENT_AGENT_SCHEDULE=0 9 * * 2
REVENUE_AGENT_SCHEDULE=0 2 * * *

# ── Content Agent Settings ───────────────────────────────────────────────
# Set to a subset (e.g. linkedin_post) and 1 for cheaper testing
A6_CONTENT_FORMATS=linkedin_post,email_sequence,case_study,blog_article,sales_deck_outline
A6_MAX_BRIEFS=3

