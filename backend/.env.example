# ═══════════════════════════════════════════════════════════════════════════
#  GTM Platform — Production Environment Configuration Template
#  Copy this template to .env and configure with your actual production secrets.
#  NEVER commit live credentials or API tokens to source control.
# ═══════════════════════════════════════════════════════════════════════════

# ── APPLICATION CONFIG ───────────────────────────────────────────────────
APP_ENV=production
APP_SECRET_KEY=change-me-to-a-long-random-32-byte-hex-string
DEBUG=false
FRONTEND_URL=https://app.yourdomain.com
CORS_ORIGINS=https://app.yourdomain.com,http://localhost:3000

# ── AUTHENTICATION ───────────────────────────────────────────────────────
AUTH_ENABLED=true
JWT_SECRET_KEY=change-me-to-a-secure-jwt-signing-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14
# Optional backfill owner for legacy unowned data. Leave empty in fresh production.
GTM_MIGRATION_OWNER_EMAIL=
# Optional password for the migration owner account.
GTM_MIGRATION_OWNER_PASSWORD=

# ── DATABASE (PostgreSQL) ────────────────────────────────────────────────
POSTGRES_USER=gtm
POSTGRES_PASSWORD=your_secure_postgres_password
POSTGRES_DB=gtm_platform
DATABASE_URL=postgresql+asyncpg://gtm:your_secure_postgres_password@localhost:5432/gtm_platform

# ── REDIS & CELERY ───────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── LLM PROVIDERS ────────────────────────────────────────────────────────
# Primary & fallback chain: Anthropic (Claude) -> Groq -> Gemini -> Mistral -> DeepSeek
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
MISTRAL_API_KEY=your_mistral_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here
JINA_API_KEY=your_jina_api_key_here
USE_GROQ=false
EMBEDDING_MODEL=miniLM

# ── APOLLO.IO (Lead Discovery & Enrichment) ──────────────────────────────
APOLLO_API_KEY=your_apollo_api_key_here
APOLLO_SEARCH_MAX_PAGES=10
APOLLO_SEARCH_PER_PAGE=100
APOLLO_CANDIDATE_POOL_SIZE=150
APOLLO_ENRICH_LIMIT=25
APOLLO_INCLUDE_SIMILAR_TITLES=false

# ── SIGNAL APIS ──────────────────────────────────────────────────────────
# Adzuna (Job Postings & Hiring Demand)
ADZUNA_APP_ID=your_adzuna_app_id_here
ADZUNA_API_KEY=your_adzuna_api_key_here

# News & Expansion Signals
NEWS_API_KEY=your_news_api_key_here
CURRENTS_API_KEY=your_currents_api_key_here
PREDICTLEADS_API_KEY=your_predictleads_api_key_here
PREDICTLEADS_API_TOKEN=your_predictleads_token_here

# Apify (Web Scraping & Social Signals)
APIFY_API_TOKEN=your_apify_api_token_here

# ── EMAIL (SMTP & Inbound Polling) ───────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_company_email@yourdomain.com
SMTP_PASSWORD=your_email_app_password
SMTP_FROM_EMAIL=your_company_email@yourdomain.com

# Gmail OAuth & IMAP (Optional per-user OAuth in multi-user deployments)
GMAIL_CLIENT_ID=your_google_oauth_client_id_here
GMAIL_CLIENT_SECRET=your_google_oauth_client_secret_here
GMAIL_REDIRECT_URI=https://app.yourdomain.com/api/v1/auth/gmail/callback

# Test mode email override (Leave EMPTY in production so real prospects receive outreach)
# When set, inbound replies are strictly restricted to this single address for staging testing.
TEST_EMAIL_OVERRIDE=

# ── RESEND (Transactional Email) ─────────────────────────────────────────
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=outreach@yourdomain.com

# ── SLACK (Approval Workflow & Alerts) ───────────────────────────────────
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token-here
SLACK_SIGNING_SECRET=your_slack_signing_secret_here
SLACK_APPROVAL_CHANNEL=gtm-approvals
SLACK_ALERTS_CHANNEL=gtm-alerts

# ── CAL.COM (Meeting Scheduling) ─────────────────────────────────────────
CAL_COM_API_KEY=your_cal_com_api_key_here
CAL_COM_BASE_URL=https://api.cal.com/v2
CAL_COM_API_VERSION=2024-06-14
CAL_COM_EVENT_SLUG=your_meeting_event_slug_here
CAL_COM_ORG_SLUG=yourcompany
CAL_COM_DEFAULT_EVENT_SLUG=15min

# ── SALESFORCE (Sole CRM Source of Truth) ───────────────────────────────
SALESFORCE_INSTANCE_URL=https://yourcompany.my.salesforce.com
SALESFORCE_ACCESS_TOKEN=your_salesforce_access_token_here
SALESFORCE_CLIENT_ID=your_connected_app_client_id_here
SALESFORCE_CLIENT_SECRET=your_connected_app_client_secret_here
SALESFORCE_API_VERSION=v60.0

# ── WEBHOOK / PUBLIC URL ─────────────────────────────────────────────────
INBOUND_WEBHOOK_SECRET=your_secure_inbound_webhook_secret_here
FIREFLIES_API_KEY=your_fireflies_api_key_here
FIREFLIES_WEBHOOK_SECRET=your_fireflies_webhook_secret_here

# ── FEATURE FLAGS & APPROVAL GATES ───────────────────────────────────────
ENABLE_EMAIL_SENDING=false        # SAFETY: Set true only after domain verification
DRY_RUN_OUTREACH=true             # SAFETY: Flip to false only after verifying test emails
REQUIRE_HUMAN_APPROVAL=true       # Human-in-the-loop approval gate for outreach drafts
ENABLE_SLACK_APPROVALS=true       # Route approvals to Slack channel
ALLOW_DEMO_PROSPECTS=false        # Disable mock/demo prospects in production
AGENT3_TEST_MODE=false            # Staging test mode toggle

# ── SCORING THRESHOLDS ───────────────────────────────────────────────────
ICP_SCORE_THRESHOLD=70
SIGNAL_SCORE_THRESHOLD=40
READINESS_SCORE_MEETING_THRESHOLD=60
EMAIL_DEDUP_DAYS=60
SIGNAL_DEDUP_HOURS=24
CONTENT_DEDUP_HOURS=24
ALLOW_REPEAT_OUTREACH_FOR_NEW_SIGNAL=true

# ── CELERY BEAT SCHEDULES (Cron format, no inline comments) ──────────────
PROSPECT_AGENT_SCHEDULE=0 8 * * 1
SIGNAL_AGENT_SCHEDULE=0 * * * *
CONTENT_AGENT_SCHEDULE=0 9 * * 2
REVENUE_AGENT_SCHEDULE=0 2 * * *
