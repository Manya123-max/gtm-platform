# ═══════════════════════════════════════════════════════════════════════════
#  GTM Platform — Production Environment Configuration for Render & Netlify
# ═══════════════════════════════════════════════════════════════════════════
#
# INSTRUCTIONS:
# 1. In Render Dashboard (gtm-backend Web Service & Celery Workers):
#    Set each key below under "Environment Variables".
# 2. In Netlify Dashboard (Frontend site settings):
#    Set VITE_API_URL to your Render web service URL (e.g. https://gtm-backend.onrender.com)
#
# ── CORE APPLICATION SETTINGS ─────────────────────────────────────────────
APP_ENV=production
DEBUG=false
APP_SECRET_KEY=change-to-a-random-32-character-secret
JWT_SECRET_KEY=change-to-a-secure-jwt-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14
AUTH_ENABLED=true

# ── FRONTEND & CORS ALIGNMENT ─────────────────────────────────────────────
# Set to your live Netlify production domain (without trailing slash)
FRONTEND_URL=https://dashing-sorbet-fd7cd5.netlify.app
CORS_ORIGINS=https://dashing-sorbet-fd7cd5.netlify.app

# ── DATABASE & QUEUE (Render Managed) ──────────────────────────────────────
# On Render, set from Database: gtm-db connectionString
DATABASE_URL=postgresql+asyncpg://gtm:<PASSWORD>@<RENDER_HOST>:5432/gtm
# On Render, set from Redis Service: gtm-redis connectionString
REDIS_URL=redis://<RENDER_REDIS_HOST>:6379/0
CELERY_BROKER_URL=redis://<RENDER_REDIS_HOST>:6379/1
CELERY_RESULT_BACKEND=redis://<RENDER_REDIS_HOST>:6379/2

# ── LLM PROVIDERS ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
MISTRAL_API_KEY=your_mistral_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here
JINA_API_KEY=your_jina_api_key_here
USE_GROQ=false
EMBEDDING_MODEL=miniLM

# ── DATA ENRICHMENT & SIGNAL SOURCES ─────────────────────────────────────
APOLLO_API_KEY=your_apollo_api_key_here
APOLLO_SEARCH_MAX_PAGES=10
APOLLO_SEARCH_PER_PAGE=100
APOLLO_CANDIDATE_POOL_SIZE=150
APOLLO_ENRICH_LIMIT=25

# Adzuna
ADZUNA_APP_ID=your_adzuna_app_id_here
ADZUNA_API_KEY=your_adzuna_api_key_here

# News & Funding Signals
NEWSAPI_API_KEY=your_newsapi_api_key_here
CURRENTS_API_KEY=your_currents_api_key_here
PREDICTLEADS_API_KEY=your_predictleads_api_key_here
PREDICTLEADS_USER_TOKEN=your_predictleads_user_token_here

# Social Intelligence (Reddit)
APIFY_API_TOKEN=your_apify_api_token_here

# ── SALES REP SCHEDULING (Cal.com) ───────────────────────────────────────
CAL_COM_API_KEY=your_cal_com_api_key_here

# ── OUTREACH & INBOUND INTEGRATIONS (Microsoft 365 / Google OAuth) ────────
MICROSOFT_CLIENT_ID=your_azure_ad_client_id_here
MICROSOFT_CLIENT_SECRET=your_azure_ad_client_secret_here
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=https://<your-render-backend-url>/api/v1/integrations/microsoft/callback

GOOGLE_CLIENT_ID=your_google_oauth_client_id_here
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret_here
GOOGLE_REDIRECT_URI=https://<your-render-backend-url>/api/v1/integrations/google/callback

# ── NOTIFICATIONS & AUDIT ────────────────────────────────────────────────
SLACK_BOT_TOKEN=your_slack_bot_token_here
SLACK_SIGNING_SECRET=your_slack_signing_secret_here
SLACK_DEFAULT_CHANNEL=sales-intelligence

